LOG_TO_FILE=true
LOG_DIR=/var/log/factoryiq


# ============================================================
# Redis - Redis is running on Windows host
# ============================================================

REDIS_HOST=host.docker.internal
REDIS_PORT=6379

REDIS_RATE_LIMIT=100
REDIS_RATE_WINDOW=60


